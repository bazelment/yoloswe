load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "nebula-orch_lib",
    srcs = [
        "concierge.go",
        "config.go",
        "main.go",
        "metrics.go",
        "planner.go",
        "runner.go",
    ],
    importpath = "github.com/bazelment/yoloswe/orch/cmd/nebula-orch",
    visibility = ["//visibility:private"],
    deps = [
        "//orch/clock",
        "//orch/controller",
        "//orch/dispatcher",
        "//orch/lane",
        "//orch/lane/nebula",
        "//orch/model",
        "//orch/recipe",
        "//orch/store",
    ],
)

go_binary(
    name = "nebula-orch",
    embed = [":nebula-orch_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "nebula-orch_test",
    srcs = ["main_test.go"],
    data = glob(["testdata/**"]),
    embed = [":nebula-orch_lib"],
    deps = [
        "//orch/clock",
        "//orch/lane",
        "//orch/model",
        "//orch/recipe",
        "//orch/store",
    ],
)
