load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "concierge",
    srcs = [
        "concierge.go",
        "prompt.go",
    ],
    importpath = "github.com/bazelment/yoloswe/orch/concierge",
    visibility = ["//visibility:public"],
    deps = [
        "//orch/clock",
        "//orch/lane",
        "//orch/model",
        "//orch/recipe",
        "//orch/store",
    ],
)

go_test(
    name = "concierge_test",
    srcs = ["concierge_test.go"],
    data = glob(["testdata/**"]),
    deps = [
        ":concierge",
        "//orch/clock",
        "//orch/lane",
        "//orch/model",
        "//orch/recipe",
        "//orch/store",
    ],
)
