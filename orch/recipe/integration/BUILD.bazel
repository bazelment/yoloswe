# gazelle:ignore
load("@rules_go//go:def.bzl", "go_test")

# Manual live integration test that exercises orch/recipe.Compiler against a
# real Anthropic Messages API or llm-gateway endpoint.
#
# Run with:
#   bazel test //orch/recipe/integration:integration_test \
#       --test_tag_filters=integration --test_output=streamed
go_test(
    name = "integration_test",
    size = "medium",
    srcs = ["live_test.go"],
    env_inherit = [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_CUSTOM_HEADERS",
        "ANTHROPIC_MODEL",
        "UPDATE_FIXTURES",
    ],
    gotags = ["integration"],
    tags = [
        "integration",
        "local",
        "manual",
    ],
    deps = [
        "//orch/model",
        "//orch/recipe",
    ],
)
