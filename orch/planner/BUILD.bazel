load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "planner",
    srcs = [
        "plan_reader.go",
        "planner.go",
        "prompt.go",
    ],
    importpath = "github.com/bazelment/yoloswe/orch/planner",
    visibility = ["//visibility:public"],
    deps = [
        "//orch/clock",
        "//orch/controller",
        "//orch/lane",
        "//orch/model",
        "//orch/recipe",
        "//orch/store",
    ],
)

go_test(
    name = "planner_test",
    srcs = ["planner_test.go"],
    data = glob(["testdata/**"]),
    deps = [
        ":planner",
        "//orch/clock",
        "//orch/concierge",
        "//orch/controller",
        "//orch/lane",
        "//orch/model",
        "//orch/recipe",
        "//orch/store",
    ],
)
