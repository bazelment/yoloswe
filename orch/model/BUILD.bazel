load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "model",
    srcs = [
        "http_client.go",
        "model.go",
        "openai_client.go",
    ],
    importpath = "github.com/bazelment/yoloswe/orch/model",
    visibility = ["//visibility:public"],
    deps = ["//orch/clock"],
)

go_test(
    name = "model_test",
    srcs = [
        "model_test.go",
        "openai_client_test.go",
    ],
    data = glob(["testdata/**"]),
    deps = [":model"],
)
