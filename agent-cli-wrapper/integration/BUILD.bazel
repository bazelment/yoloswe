# gazelle:ignore
load("@rules_go//go:def.bzl", "go_test")

# Generic, table-driven session-resume integration test that exercises every
# agent-CLI backend (claude, codex, cursor) with the same secret-recall
# scenario.
#
# "local" disables sandboxing so the test can reach each CLI binary and the
# user's auth state (~/.claude, ~/.codex, ~/.cursor).
# "manual" excludes the test from `bazel test //...`.
#
# Run with:
#   bazel test //agent-cli-wrapper/integration:integration_test \
#       --test_tag_filters=integration --test_output=streamed
go_test(
    name = "integration_test",
    # Each subtest spends 10–60s waiting on a real model, and the full suite
    # sequences three backends, so bazel's default 60s is far too small.
    #
    # "eternal" (3600s), not the "large" default of 900s, because the OpenRouter
    # claude leg retries a known CLI defect and its declared budget must FIT
    # this number — a retry count larger than the target timeout cannot be
    # reached, and bazel kills the target with a message naming neither the
    # retries nor the endpoint. Worst case, summed:
    #
    #   OpenRouter claude   10 attempts x 180s (claudeMaxAttempts,
    #                                          openRouterTimeout)   1800s
    #   OpenRouter codex     1 attempt  x 180s                       180s
    #   Baseten both legs    1 attempt  x  90s x 2                   180s
    #   resume_test.go       3 backends x ~60s                       180s
    #                                                        total  2340s
    #
    # Changing claudeMaxAttempts or openRouterTimeout means redoing this sum.
    size = "large",
    timeout = "eternal",
    srcs = [
        "llmendpoint_test.go",
        "openrouter_test.go",
        "resume_test.go",
    ],
    # The agent CLIs need real user state to authenticate and run:
    #   HOME / USER          — cursor's `agent` launcher uses `set -u` and
    #                          dies on unbound HOME; auth state lives under
    #                          ~/.claude, ~/.codex, ~/.cursor.
    #   PATH                 — the wrappers exec the CLI binary by name.
    #   XDG_*_HOME           — cursor + node compile cache locations.
    env_inherit = [
        # BASETEN_API_KEY: gates TestLLMEndpoint_Baseten; the test skips
        # cleanly when unset so the rest of the suite still runs.
        "BASETEN_API_KEY",
        "HOME",
        # OPEN_ROUTER_KEY: gates TestLLMEndpoint_OpenRouter and deliberately
        # exercises overriding the preset's conventional API key env var.
        "OPEN_ROUTER_KEY",
        "PATH",
        "USER",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
    ],
    gotags = ["integration"],
    tags = [
        "integration",
        "local",
        "manual",
    ],
    deps = [
        "//agent-cli-wrapper/claude",
        "//agent-cli-wrapper/codex",
        "//agent-cli-wrapper/cursor",
        "//agent-cli-wrapper/llmendpoint",
    ],
)
