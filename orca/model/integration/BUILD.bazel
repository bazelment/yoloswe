# gazelle:ignore
load("@rules_go//go:def.bzl", "go_test")

# Manual live integration test that exercises orca/model.HTTPClient against a
# real Anthropic Messages API or llm-gateway endpoint.
#
# Run with:
#   bazel test //orca/model/integration:integration_test \
#       --test_tag_filters=integration --test_output=streamed
go_test(
    name = "integration_test",
    size = "medium",
    srcs = ["live_test.go"],
    env_inherit = [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_CUSTOM_HEADERS",
        "ANTHROPIC_MODEL",
    ],
    gotags = ["integration"],
    tags = [
        "integration",
        "local",
        "manual",
    ],
    deps = ["//orca/model"],
)
