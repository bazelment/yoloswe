load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "model",
    srcs = [
        "cli_client.go",
        "http_client.go",
        "model.go",
        "openai_client.go",
        "tool_name_codec.go",
    ],
    importpath = "github.com/bazelment/yoloswe/orca/model",
    visibility = ["//visibility:public"],
    deps = ["//orca/clock"],
)

go_test(
    name = "model_test",
    srcs = [
        "cli_client_test.go",
        "model_test.go",
        "openai_client_test.go",
    ],
    data = glob(["testdata/**"]),
    deps = [
        ":model",
        "//orca/clock",
    ],
)
