load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "store",
    srcs = [
        "contract.go",
        "memory.go",
        "sqlite.go",
        "store.go",
        "types.go",
    ],
    embedsrcs = [
        "migrations/0001_init.sql",
        "migrations/0002_memory_notes.sql",
        "migrations/0003_decision_trace.sql",
        "migrations/0004_lane_base_commit.sql",
        "migrations/0005_run_settings.sql",
    ],
    importpath = "github.com/bazelment/yoloswe/orca/store",
    visibility = ["//visibility:public"],
    deps = [
        "//orca/clock",
        "//orca/lane",
        "//orca/model",
        "//orca/recipe",
        "@org_modernc_sqlite//:sqlite",
    ],
)

go_test(
    name = "store_test",
    srcs = [
        "memory_test.go",
        "sqlite_test.go",
    ],
    deps = [
        ":store",
        "//orca/clock",
        "//orca/lane",
        "//orca/model",
        "//orca/recipe",
    ],
)
