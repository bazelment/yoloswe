# gazelle:ignore
load("@rules_go//go:def.bzl", "go_test")

# Manual integration test: the adoption handover against the installed
# subagent-swarm-nebula watch_lanes.sh (real processes and signals).
#
# Run with:
#   bazel test //orca/adopt/integration:integration_test \
#       --test_env=ORCA_WATCH_LANES=$HOME/.claude/skills/subagent-swarm-nebula/scripts/watch_lanes.sh
go_test(
    name = "integration_test",
    size = "small",
    srcs = ["watcher_test.go"],
    env_inherit = ["ORCA_WATCH_LANES"],
    gotags = ["integration"],
    tags = [
        "integration",
        "local",
        "manual",
    ],
    deps = ["//orca/adopt"],
)
