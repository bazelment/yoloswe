load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "chat",
    srcs = [
        "chat.go",
        "store.go",
    ],
    importpath = "github.com/bazelment/yoloswe/orca/chat",
    visibility = ["//visibility:public"],
    deps = [
        "//orca/adopt",
        "//orca/concierge",
        "//orca/controller",
