    deps = [
        "//orca/adopt",
        "//orca/clock",
        "//orca/concierge",
        "//orca/controller",
        "//orca/dispatcher",
        "//orca/lane",
        "//orca/mailbox",
        "//orca/model",
        "//orca/router",
        "//orca/store",
        "@com_github_charmbracelet_x_exp_teatest_v2//:teatest",
        "@land_charm_bubbletea_v2//:bubbletea",
    ],
