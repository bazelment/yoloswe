load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dispatcher",
    srcs = [
        "dispatcher.go",
        "prompt.go",
        "snapshot.go",
        "truncation.go",
        "vet.go",
    ],
    importpath = "github.com/bazelment/yoloswe/orca/dispatcher",
