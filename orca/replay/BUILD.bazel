load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "replay",
    srcs = [
        "concierge.go",
        "dataset.go",
        "eval.go",
        "source.go",
        "split.go",
    ],
    embedsrcs = [
        "testdata/gate2_dataset.json",
        "testdata/inner_loop_10.json",
        "testdata/source_excerpt.json",
    ],
    importpath = "github.com/bazelment/yoloswe/orca/replay",
