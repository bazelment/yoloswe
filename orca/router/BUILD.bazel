load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "router",
    srcs = [
        "eval.go",
        "router.go",
    ],
    embedsrcs = ["testdata/owner_chat.json"],
    importpath = "github.com/bazelment/yoloswe/orca/router",
    visibility = ["//visibility:public"],
    deps = [
        "//orca/model",
        "//orca/store",
    ],
)

go_test(
    name = "router_test",
    srcs = [
        "eval_test.go",
        "router_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":router"],
    deps = [
        "//orca/model",
        "//orca/store",
    ],
)
