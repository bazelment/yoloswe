load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "orca_lib",
    srcs = [
        "adopt.go",
        "chat_stream.go",
        "concierge.go",
        "config.go",
        "ghpr.go",
        "main.go",
        "metrics.go",
        "planner.go",
        "report_export.go",
        "runner.go",
    ],
    importpath = "github.com/bazelment/yoloswe/orca/cmd/orca",
    visibility = ["//visibility:private"],
    deps = [
        "//orca/adopt",
        "//orca/brief",
        "//orca/chat",
        "//orca/clock",
        "//orca/concierge",
        "//orca/controller",
        "//orca/dispatcher",
        "//orca/lane",
        "//orca/lane/nebula",
        "//orca/mailbox",
        "//orca/mailbox/nebula",
        "//orca/model",
        "//orca/planner",
        "//orca/recipe",
        "//orca/replay",
        "//orca/router",
        "//orca/store",
        "@org_golang_x_term//:term",
    ],
)

go_binary(
    name = "orca",
    embed = [":orca_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "orca_test",
    srcs = [
        "adopt_test.go",
        "chat_stream_test.go",
        "concierge_directive_test.go",
        "concierge_test.go",
        "ghpr_test.go",
        "main_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":orca_lib"],
    deps = [
        "//orca/adopt",
        "//orca/chat",
        "//orca/clock",
        "//orca/controller",
        "//orca/dispatcher",
        "//orca/lane",
        "//orca/mailbox",
        "//orca/mailbox/fake",
        "//orca/model",
        "//orca/planner",
        "//orca/recipe",
        "//orca/store",
    ],
)
