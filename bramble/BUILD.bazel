load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "bramble_lib",
    srcs = [
        "logfile.go",
        "main.go",
        "restart.go",
        "restart_signals_other.go",
        "restart_signals_unix.go",
    ],
    importpath = "github.com/bazelment/yoloswe/bramble",
    visibility = ["//visibility:private"],
    deps = [
        "//agent-cli-wrapper/llmendpoint",
        "//bramble/app",
        "//bramble/cmd/addrepo",
        "//bramble/cmd/codereview",
        "//bramble/cmd/delegator",
        "//bramble/cmd/meetingbot",
        "//bramble/cmd/speak",
        "//bramble/control",
        "//bramble/ipc",
        "//bramble/remote",
        "//bramble/selfexec",
        "//bramble/session",
        "//bramble/taskrouter",
        "//bramble/tmuxctl",
        "//cliapp",
        "//logging/klogfmt",
        "//multiagent/agent",
        "//wt",
        "//yoloswe",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_spf13_pflag//:pflag",
        "@land_charm_bubbletea_v2//:bubbletea",
        "@org_golang_x_term//:term",
    ],
)

go_binary(
    name = "bramble",
    embed = [":bramble_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bramble_test",
    srcs = [
        "list_sessions_test.go",
        "logfile_test.go",
        "main_test.go",
        "new_session_test.go",
        "notify_cmd_test.go",
        "notify_session_id_test.go",
        "restart_test.go",
        "socket_path_test.go",
    ],
    embed = [":bramble_lib"],
    deps = [
        "//agent-cli-wrapper/llmendpoint",
        "//bramble/app",
        "//bramble/ipc",
        "//bramble/session",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
